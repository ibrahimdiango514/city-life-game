# ============================================================
# CITY LIFE GAME — Configuration Supabase (côté client)
# ============================================================
# N'utilisez QUE la clé PUBLISHABLE (ou "anon" legacy).
# Ces clés sont publiques par conception et protégées par les
# politiques RLS du schéma city_life_game.
#
# NE JAMAIS mettre ici :
#   - sb_secret_... / service_role           -> accès admin total
#   - toute clé secrète d'IA (OpenAI, etc.)  -> passera par les Edge Functions
#
# Copiez ce fichier en `.env` et renseignez vos valeurs :
#   cp .env.example .env
# ============================================================

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle_ici

# ------------------------------------------------------------
# OPTIONNEL — Dialogue génératif (Edge Function city-life-dialogue)
# ------------------------------------------------------------
# Laissez VIDE pour jouer avec le moteur de dialogue LOCAL (intégré,
# gratuit, hors-ligne) — c'est le mode par défaut.
# Pour activer l'IA : déployez l'Edge Function puis renseignez son URL, ex.
#   VITE_DIALOGUE_ENDPOINT=https://votre-projet.supabase.co/functions/v1/city-life-dialogue
# La clé d'IA reste un SECRET Supabase côté serveur (AI_API_KEY) — jamais ici.
VITE_DIALOGUE_ENDPOINT=
